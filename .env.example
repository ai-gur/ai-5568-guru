# AI 5568 Guru — environment
#
# Copy this file to `.env.local` in the same directory and fill it in.
# `.env.local` is gitignored. This file is not — so it must never hold a value.
#
#   cp .env.example .env.local
#
# ─────────────────────────────────────────────────────────────────────────────
# THE ONE RULE
#
# Only NEXT_PUBLIC_* reaches the browser. Everything else is server-side only.
# A service-role key or an AI provider key behind a NEXT_PUBLIC_ prefix is
# published to every visitor, permanently, the moment the app builds.
# ─────────────────────────────────────────────────────────────────────────────


# ── Supabase ────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API

# Safe in the browser: the project URL and the anon key, which is constrained by
# Row Level Security. RLS is what makes it safe — not the key.
# project: ai-5568-guru, region eu-west-1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️ SERVER ONLY. Bypasses Row Level Security entirely. Never prefix this with
# NEXT_PUBLIC_, never send it to the client, never log it.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string, for migrations only.
SUPABASE_DB_URL=


# ── Scanner service ─────────────────────────────────────────────────────────
# The scanner runs in its own private container: it needs Playwright, Node and
# a Python sidecar, so it cannot run on Cloudflare Workers. The web app reaches
# it over an internal API and must be the only thing that can.

SCANNER_URL=http://127.0.0.1:3569
SCANNER_TOKEN=


# ── AI provider ─────────────────────────────────────────────────────────────
# ⚠️ SERVER ONLY, and only in the scanner service — never in the web app.
# Roughly 55 of the 60 catalogue rows need the judgement layer.

ANTHROPIC_API_KEY=

# Hard ceiling on judgement spend per scan, in USD. The run degrades rows to
# "unverified" rather than exceeding it — see judge.ts.
AI_BUDGET_USD=10


# ── Cloudflare ──────────────────────────────────────────────────────────────
# R2 holds reports and screenshots. Access is by signed URL only, so these
# credentials stay server-side.

# account: ai@aiguru.co.il
CLOUDFLARE_ACCOUNT_ID=
# Only needed if something outside Cloudflare writes to R2 directly. An app on
# Pages/Workers uses a binding and needs no keys at all — simpler and safer.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ai5568-reports


# ── Ownership verification ──────────────────────────────────────────────────
# A shallow review is open to any public address. A full review requires proof
# that the requester controls the domain — either a DNS TXT record or a file at
# the site root. This is the token prefix those carry.

# Signs the derived ownership tokens. Changing it invalidates every
# outstanding proof, so treat it as permanent once a customer has
# published a record.
OWNERSHIP_TOKEN_SECRET=

OWNERSHIP_TOKEN_PREFIX=ai5568-verify
